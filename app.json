{
  "expo": {
    "name": "Desafio Aceito",
    "slug": "desafio-aceito-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.futtech.desafioaceito"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#193a32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.futtech.desafioaceito",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#193a32",
          "imageWidth": 170
        }
      ]
    ],
    "scheme": "desafioaceito",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "696573dc-edc2-49fd-94f6-6dae4566dddd"
      }
    }
  }
}
