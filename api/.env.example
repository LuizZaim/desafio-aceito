PORT=3000
DATABASE_URL=postgresql://desafio:troque_esta_senha@localhost:5432/desafio_aceito
DB_SSL=false
# Opcional para clientes web. O app nativo usa Bearer token e não depende de CORS.
CORS_ORIGINS=http://localhost:8081

# Recuperação por e-mail e confirmação de novo endereço (opcional).
# Sem essas credenciais, os endpoints informam indisponibilidade; não simulam envio.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Porta 587: SMTP_SECURE=false exige STARTTLS; certificados sempre verificados.
PASSWORD_RESET_URL=desafioaceito://recuperar
EMAIL_CONFIRMATION_URL=desafioaceito://confirmar-email
# Códigos de recuperação autenticados funcionam sem SMTP e são mostrados uma única vez.

# OAuth Web client ID público e confiável do projeto Google (não é client secret).
# Sem configuração, o endpoint informa indisponibilidade e não aceita tokens Google.
GOOGLE_WEB_CLIENT_ID=

# Render Free bloqueia SMTP: selecione brevo para envio HTTPS (sem fallback automático).
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=
